# 复制为 .env 后按需修改：cp .env.example .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=diet_db
MYSQL_PORT=3306

# ---------- 应用 ----------
APP_PORT=8080

# ---------- LLM 网关（OpenAI 兼容）----------
# 容器内访问宿主机上的服务用 host.docker.internal；也可以填任意公网地址
DIET_LLM_BASE_URL=http://host.docker.internal:7863/v1
DIET_LLM_API_KEY=
DIET_LLM_MAIN_MODEL=qwen-max
DIET_LLM_LIGHT_MODEL=qwen-turbo
